# Copy to .env for local development:  cp .env.example .env
# In production these are set as Portainer stack environment variables, never committed.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobfinder
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Web (prod only: host port the SPA is served on) ---
WEB_PORT=8080

# --- LLM (used from Phase 2 onward) ---
# Either/or: pick ONE provider, supply its key, and choose a model valid for it.
# The unused provider's key can be left blank.
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-4-6     # e.g. claude-sonnet-4-6 (anthropic) | gpt-4o (openai)
ANTHROPIC_API_KEY=              # required when LLM_PROVIDER=anthropic
OPENAI_API_KEY=                 # required when LLM_PROVIDER=openai

# --- Auth (Phase 6 — OIDC relying-party) ---
# Set these to your OIDC provider's values.  The provider must support discovery
# (RFC 8414 / OpenID Connect Discovery 1.0).
# Examples: https://accounts.google.com  |  Authentik  |  Keycloak  |  Dex
OIDC_ISSUER=https://auth.example.com/realms/myrealm
OIDC_CLIENT_ID=job-finder
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
# Comma-separated list of permitted email addresses.  Leave blank to allow any
# authenticated identity (useful when the provider already restricts access).
OIDC_ALLOWED_EMAILS=
# Random secret used to sign session JWTs.  Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# --- Source credentials (added as adapters land) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
